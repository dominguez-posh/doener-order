# Kopieren nach .env und anpassen. Die Datei .env niemals einchecken.

# Port des Webservers (Azure Web App setzt PORT selbst)
PORT=3000

# Öffentliche Adresse, unter der die Seite erreichbar ist (für den PayPal-Rücksprung).
# Leer lassen = wird aus der Anfrage abgeleitet (reicht lokal).
# BASE_URL=https://doener.example.de

# Speicherort der SQLite-Datenbank. Azure Web App (Linux): /home/data
# DATA_DIR=./data

# Hinter einem Reverse-Proxy / Azure: true
# TRUST_PROXY=true

# PayPal Checkout (nur mit PayPal-Business-Konto). Ohne diese Werte läuft der PayPal.me-Modus.
# Zugangsdaten: https://developer.paypal.com → Apps & Credentials → REST-App anlegen
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
